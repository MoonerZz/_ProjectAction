# Without credentials, next dev uses local mock authentication.
AUTH_MODE=mock
# Explicit opt-in required to run mock authentication with next start.
ALLOW_MOCK_AUTH=false
# Set a random secret of at least 32 characters for stable mock sessions.
MOCK_SESSION_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000
